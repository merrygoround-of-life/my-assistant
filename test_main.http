POST http://127.0.0.1:8000/api/v1/entity/user
Content-Type: application/json
Accept: application/json

{
  "name": "Isaac Park",
  "email": "merrygoroundof@naver.com",
  "groupId": 1
}

###

POST http://127.0.0.1:8000/api/v1/entity/subject
Content-Type: application/json
Accept: application/json

{
  "topic": "Chat",
  "ownerId": 1
}

###

POST http://127.0.0.1:8000/api/v1/entity/subject
Content-Type: application/json
Accept: application/json

{
  "topic": "Translation",
  "systemRole": "a helpful translator",
  "promptTemplate": "Please translate from {from_lang} to {to_lang}:",
  "ownerId": 1
}

###

POST http://127.0.0.1:8000/api/v1/entity/subject
Content-Type: application/json
Accept: application/json

{
  "topic": "Git Commit Message",
  "systemRole": "an assistant that helps create git commit messages",
  "promptTemplate": "Please translate the following into a concise and accurate expression suitable for an English git commit message:",
  "ownerId": 1
}

###

POST http://127.0.0.1:8000/api/v1/entity/subject
Content-Type: application/json
Accept: application/json

{
  "topic": "Paraphrase",
  "systemRole": "an assistant that helps paraphrase texts to match the requested level",
  "promptTemplate": "Please paraphrase the following text to match the CEFR {level} level:",
  "ownerId": 1
}

###

POST http://127.0.0.1:8000/api/v1/entity/subject
Content-Type: application/json
Accept: application/json

{
  "topic": "Grammar",
  "systemRole": "an assistant that explains English sentence structures grammatically",
  "promptTemplate": "Please explain the following sentence structure grammatically in Korean so that a CEFR {level} learner can understand it:",
  "ownerId": 1
}

